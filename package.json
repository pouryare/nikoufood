{
  "name": "nikoufood",
  "version": "0.1.0",
  "private": true,
  "description": "Nikoo Etemad corporate website (Next.js + Payload CMS)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "gsap": "3.15.1",
    "motion": "14.12.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "three": "0.187.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
