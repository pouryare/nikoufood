# Day-to-day commands
app_logs() {
  if [ "$MODE" = docker ]; then compose logs --tail "${1:-200}" app; else journalctl -u "$SERVICE" -n "${1:-200}" --no-pager; fi
}
cmd_logs() { need_root logs; load_conf; if [ "$MODE" = docker ]; then compose logs -f --tail 200 app; else journalctl -u "$SERVICE" -f -n 200; fi; }

cmd_status() {
  need_root status; load_conf
  local v
  if [ "$MODE" = docker ]; then v=$(image_ref nikoufood); else v=$(current_version); fi
  printf 'Site:        https://%s\nRun as:      %s (%s)\nVersion:     %s\nDatabase:    %s\n' "$DOMAIN" "$MODE" "$(app_running && echo running || echo STOPPED)" "${v:-unknown}" "$DB_MODE"
  curl -fsS -o /dev/null --max-time 8 "http://127.0.0.1:$APP_PORT/robots.txt" && echo "Answers:     yes (port $APP_PORT)" || echo "Answers:     NO"
  [ ! -f "$CONF_DIR/maintenance.on" ] || echo "Maintenance: ON (nikou maintenance off)"
  if [ "$MODE" = docker ]; then [ ! -f "$ROOT/incoming/pending-tag" ] || echo "Waiting:     a new version, applied tonight at $UPGRADE_AT (or: nikou upgrade-scheduled)"
  else
    local w; w=$(ls -1 "$ROOT"/incoming/nikoufood-*-linux-*.tar.gz 2>/dev/null | sort -V | tail -1 || true)
    [ -z "$w" ] || [ ! -f "$w.sha256" ] || [ "$(basename "$w")" = "nikoufood-$(current_version)-linux-$(machine_arch).tar.gz" ] || echo "Waiting:     $(basename "$w"), applied tonight at $UPGRADE_AT (or: nikou upgrade-scheduled)"
  fi
  local last; last=$(ls -1t "$BACKUPS"/nikou-db-*.sql.gz 2>/dev/null | head -1 || true)
  printf 'Last backup: %s\nDisk free:   %s GB\n' "${last:-none}" "$(df -Pk / | awk 'NR==2 {print int($4/1048576)}')"
}

cmd_doctor() {
  need_root doctor; load_conf
  local bad=0
  ok() { printf '  ok    %s\n' "$*"; }
  no() { printf '  FAIL  %s\n' "$*"; bad=1; }
  wn() { printf '  warn  %s\n' "$*"; }
  printf 'Checking this server:\n'
  app_running && ok "the site is running ($MODE)" || no "the site is not running (nikou logs)"
  curl -fsS -o /dev/null --max-time 8 "http://127.0.0.1:$APP_PORT/robots.txt" && ok "answers on port $APP_PORT" || no "does not answer on port $APP_PORT"
  if curl -fsS -o /dev/null --max-time 15 "http://127.0.0.1:$APP_PORT/"; then ok "the home page renders"; elif [ "$LOAD_SEED" = 1 ]; then no "the home page does not render (nikou logs)"; else wn "the home page does not render yet (normal for an empty database: fill it in /admin)"; fi
  curl -fsS -o /dev/null --max-time 10 --resolve "$DOMAIN:443:127.0.0.1" -k "https://$DOMAIN/robots.txt" && ok "HTTPS through Caddy works on this server" || no "HTTPS through Caddy does not answer"
  if [ "$DB_MODE" = builtin ]; then compose exec -T db pg_isready -U "$DB_USER" >/dev/null 2>&1 && ok "PostgreSQL container is ready" || no "PostgreSQL container is not ready"
  else test_db && ok "PostgreSQL login works ($DB_USER@$DB_HOST:$DB_PORT/$DB_NAME)" || no "cannot log in to PostgreSQL"; fi
  caddy validate --config "$CADDY_DIR/Caddyfile" >/dev/null 2>&1 && ok "Caddy configuration is valid" || no "Caddy configuration is not valid"
  [ "$(df -Pk / | awk 'NR==2 {print int($4/1048576)}')" -ge 2 ] && ok "disk space" || wn "less than 2 GB free"
  [ -n "$(env_get SMTP_HOST)" ] && [ -n "$(env_get SMTP_PASS)" ] && ok "email is set up" || wn "email is not set up: form requests are saved in /admin but not emailed (nikou secrets set SMTP_PASS)"
  [ "$BACKUP_ENABLED" = 1 ] && { [ -n "$(find "$BACKUPS" -name 'nikou-db-*' -mtime -2 2>/dev/null | head -1)" ] && ok "a backup from the last 2 days exists" || wn "no backup from the last 2 days"; } || wn "backups are off"
  systemctl is-active --quiet nikou-upgrade.timer && ok "a waiting new version is applied at $UPGRADE_AT (Tehran time)" || wn "the scheduled-upgrade timer is not active (run: sudo nikou install, which sets it up again)"
  [ -f "$CONF_DIR/github-deploy.done" ] && ok "GitHub sends new versions here (github-deploy was set up)" || wn "GitHub does not send new versions here by itself yet (sudo nikou github-deploy); until then use: sudo nikou update"
  if [ "$BACKUP_ENABLED" = 1 ]; then systemctl is-active --quiet nikou-restoretest.timer && ok "the newest backup is test-restored every Sunday" || wn "the weekly backup restore test is not scheduled"; fi
  [ -n "$(alert_to)" ] && [ -n "$(env_get SMTP_PASS)" ] && ok "failure alerts go to $(alert_to)" || wn "no failure alerts by email (needs the email setup and an alert address)"
  [ "$BEHIND_ARVAN" = 1 ] && [ "$CDN_ONLY" != 1 ] && wn "behind Arvan but the web ports are open to everyone (nikou cdn-ips --only)" || true
  other_app_present && { systemctl is-active --quiet routeflow && ok "the other app is running next to this site" || wn "the other app is installed but not running"; } || true
  return "$bad"
}

cmd_upgrade() {
  need_root upgrade; load_conf
  exec 9>"$LOCK"; flock -n 9 || die "another nikou command is running"
  if [ "$MODE" = docker ]; then
    local new=${1:-$IMAGE_TAG} old=$IMAGE_TAG
    valid_tag "$new" || die "not a valid tag: $new"
    need_free /var/lib/docker 2048 "pulling the new images"
    docker tag "$(image_ref nikoufood "$old")" "$(image_ref nikoufood nikou-rollback)" 2>/dev/null || true
    docker tag "$(image_ref nikoufood-tools "$old")" "$(image_ref nikoufood-tools nikou-rollback)" 2>/dev/null || true
    IMAGE_TAG=$new; PREVIOUS_TAG=$old; write_conf; render_compose > "$ROOT/docker-compose.yml"
    compose pull app tools || { IMAGE_TAG=$old; write_conf; render_compose > "$ROOT/docker-compose.yml"; die "could not pull $new; nothing changed"; }
    run_tools migrate || { IMAGE_TAG=$old; write_conf; render_compose > "$ROOT/docker-compose.yml"; die "the database migration failed; the site was not restarted"; }
    compose up -d --remove-orphans
    if ! wait_healthy 120; then
      warn "the new version did not answer; going back to $old"
      IMAGE_TAG=nikou-rollback; render_compose > "$ROOT/docker-compose.yml"; compose up -d --remove-orphans
      IMAGE_TAG=$old; write_conf
      die "upgrade failed and was rolled back (database changes are not undone)"
    fi
    say "now running $new (before: $old)"
  else
    local t v prev; prev=$(current_version)
    t=$(NIKOU_WANT_LATEST=1 find_tarball "${1:-}"); preflight_tarball "$t"; v=$(unpack_release "$t")
    [ "$v" != "$prev" ] || { say "version $v is already live"; return 0; }
    switch_to "$v"
    if ! run_tools migrate; then [ -z "$prev" ] || switch_to "$prev"; die "the database migration failed; still on ${prev:-nothing}"; fi
    systemctl restart "$SERVICE"
    if ! wait_healthy 120; then
      warn "version $v did not answer; going back to $prev"
      [ -z "$prev" ] || { switch_to "$prev"; systemctl restart "$SERVICE"; }
      die "upgrade failed and was rolled back (database changes are not undone)"
    fi
    prune_releases
    say "now running $v (before: ${prev:-none})"
  fi
}

# ---------------------------------------------------------------------------------------------------------
# Alerts by email. Best effort: a failed email never makes a command fail.
alert_to() { echo "${ALERT_EMAIL:-$ADMIN_EMAIL}"; }
notify() {   # notify "subject" "text"
  local to host pass port user from url tmp
  to=$(alert_to); host=$(env_get SMTP_HOST); pass=$(env_get SMTP_PASS)
  [ -n "$to" ] && [ -n "$host" ] && [ -n "$pass" ] || return 0
  port=$(env_get SMTP_PORT); port=${port:-587}; user=$(env_get SMTP_USER); from=$(env_get SMTP_FROM); from=${from:-no-reply@$DOMAIN}
  if [ "$(env_get SMTP_SECURE)" = true ]; then url="smtps://$host:$port"; else url="smtp://$host:$port"; fi
  tmp=$(mktemp)
  printf 'From: Nikoo Etemad server <%s>\nTo: <%s>\nSubject: %s\nContent-Type: text/plain; charset=utf-8\n\n%s\n' "$from" "$to" "[$DOMAIN] $1" "$2" > "$tmp"
  # shellcheck disable=SC2086
  curl -sS --max-time 30 --ssl-reqd --url "$url" --mail-from "$from" --mail-rcpt "$to" ${user:+--user "$user:$pass"} -T "$tmp" >/dev/null 2>&1 \
    || warn "could not send the alert email to $to"
  rm -f "$tmp"
  return 0
}
# alerting "what" command...   Runs the command; when a timer ran it (no terminal) and it failed, emails the last lines.
alerting() {
  local what=$1 err rc=0; shift
  load_conf
  err=$(mktemp)
  ( "$@" ) 2>"$err" || rc=$?
  cat "$err" >&2
  if [ "$rc" != 0 ] && [ ! -t 0 ]; then notify "$what failed" "$(tail -n 15 "$err")"; fi
  rm -f "$err"
  return "$rc"
}

# Run every 10 minutes by nikou-watch.timer: one email when the site stops answering (two misses in a row),
# one when it is back. Quiet during maintenance and during an upgrade.
cmd_health_check() {
  need_root health-check; load_conf
  local f=$DATA/health-misses n
  if [ -f "$CONF_DIR/maintenance.on" ]; then return 0; fi
  exec 8>"$LOCK"; flock -n 8 || return 0
  install -d "$DATA"
  if wait_healthy 9; then
    n=$(cat "$f" 2>/dev/null || echo 0); [[ $n =~ ^[0-9]+$ ]] || n=0
    if [ "$n" -ge 2 ]; then notify "the site answers again" "https://$DOMAIN is back."; fi
    rm -f "$f"
  else
    n=$(cat "$f" 2>/dev/null || echo 0); [[ $n =~ ^[0-9]+$ ]] || n=0
    n=$((n + 1)); echo "$n" > "$f"
    if [ "$n" = 2 ]; then notify "the site is not answering" "https://$DOMAIN did not answer on this server's port $APP_PORT twice in a row. On the server: sudo nikou doctor, then sudo nikou logs."; fi
    return 1
  fi
}

# ---------------------------------------------------------------------------------------------------------
# Disk space and machine checks before an upgrade
free_mb() { df -Pm "$1" 2>/dev/null | awk 'NR==2 {print $4}'; }
need_free() {   # need_free path megabytes what
  local path=$1 have; [ -d "$path" ] || path=/
  have=$(free_mb "$path"); have=${have:-0}
  [ "$have" -ge "$2" ] || die "not enough free disk space for $3: $have MB free in $path, about $2 MB needed. Nothing was changed."
}
preflight_tarball() {   # preflight_tarball file: right machine type and room to unpack it
  local t=$1 version arch mb need
  read -r version arch < <(parse_tarball_name "$t") || die "not a release tarball name: $(basename "$t")"
  [ "$arch" = "$(machine_arch)" ] || die "this tarball is for $arch, this server is $(machine_arch). Nothing was changed."
  mb=$(( $(stat -c %s "$t") / 1048576 )); need=$((mb * 4)); [ "$need" -ge 1024 ] || need=1024
  need_free "$ROOT" "$need" "unpacking $(basename "$t")"
}

# ---------------------------------------------------------------------------------------------------------
# Timers: scheduled upgrade, weekly restore test, site watch (the backup timer is written by the backup step)
write_timer() {   # write_timer name "description" "OnCalendar" "nikou command" "extra [Timer] line"
  cat > "$UNIT_DIR/$1.service" <<UNIT
[Unit]
Description=$2
[Service]
Type=oneshot
ExecStart=/usr/local/bin/nikou $4
UNIT
  cat > "$UNIT_DIR/$1.timer" <<UNIT
[Unit]
Description=$2
[Timer]
OnCalendar=$3
${5:-}
[Install]
WantedBy=timers.target
UNIT
}
s_timers() {
  [[ $UPGRADE_AT =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "UPGRADE_AT must look like 03:30 (hours:minutes, Tehran time)"
  write_timer nikou-upgrade "Nikoo Etemad: scheduled upgrade" "*-*-* $UPGRADE_AT:00 Asia/Tehran" upgrade-scheduled
  write_timer nikou-watch "Nikoo Etemad: is the site answering?" "*:0/10" health-check
  if [ "$BACKUP_ENABLED" = 1 ]; then
    write_timer nikou-restoretest "Nikoo Etemad: weekly restore test" "Sun *-*-* 04:20:00 Asia/Tehran" restore-test "Persistent=true"
  else
    systemctl disable --now nikou-restoretest.timer >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload
  systemctl enable --now nikou-upgrade.timer nikou-watch.timer >/dev/null 2>&1 || true
  [ "$BACKUP_ENABLED" != 1 ] || systemctl enable --now nikou-restoretest.timer >/dev/null 2>&1 || true
  say "a waiting new version is applied at $UPGRADE_AT Tehran time; the site is watched every 10 minutes$([ "$BACKUP_ENABLED" = 1 ] && echo '; the newest backup is test-restored on Sundays')"
}

# ---------------------------------------------------------------------------------------------------------
# nikou update: get the newest version, then ask: now, or tonight
cmd_update() {
  need_root update; load_conf
  local when=ask arg now
  for arg in "$@"; do
    case "$arg" in --now) when=now ;; --tonight | --schedule) when=tonight ;; *) die "usage: nikou update [--now|--tonight]" ;; esac
  done
  if [ "$MODE" = docker ]; then
    local ref live_id new_id
    ref=$(image_ref nikoufood latest)
    need_free /var/lib/docker 2048 "pulling the new images"
    live_id=$(docker inspect -f '{{.Image}}' "$(compose ps -q app 2>/dev/null | head -1)" 2>/dev/null || true)
    say "checking Docker Hub for $ref"
    docker pull -q "$ref" >/dev/null || die "could not pull $ref (is Docker Hub reachable? private images need: docker login)"
    new_id=$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null || true)
    if [ -n "$live_id" ] && [ "$live_id" = "$new_id" ]; then say "Already on the newest version. Nothing to do."; rm -f "$ROOT/incoming/pending-tag"; return 0; fi
    if [ "$when" = ask ]; then ask_yes now "A newer version is downloaded. Upgrade now? (No: it is applied tonight at $UPGRADE_AT.)" 0; if [ "$now" = 1 ]; then when=now; else when=tonight; fi; fi
    if [ "$when" = now ]; then cmd_upgrade latest
    else install -d -m 755 "$ROOT/incoming"; echo latest > "$ROOT/incoming/pending-tag"; say "Waiting. It is applied tonight at $UPGRADE_AT Tehran time, or at once with: sudo nikou upgrade-scheduled"; fi
  else
    local file want live
    live=$(current_version)
    file=$(NIKOU_WANT_LATEST=1 find_tarball "") || exit 1
    verify_checksum "$file" || exit 1
    want=$(parse_tarball_name "$file" | cut -d' ' -f1)
    if [ -n "$live" ] && [ "$(printf '%s\n%s\n' "$live" "$want" | sort -V | tail -1)" = "$live" ]; then
      say "Already on $live; the newest release is $want. Nothing to do."
      return 0
    fi
    if [ "$when" = ask ]; then ask_yes now "Version $want is downloaded and checked (now: ${live:-none}). Upgrade now? (No: it is applied tonight at $UPGRADE_AT.)" 0; if [ "$now" = 1 ]; then when=now; else when=tonight; fi; fi
    if [ "$when" = now ]; then cmd_upgrade "$file"
    else say "Waiting in $ROOT/incoming. It is applied tonight at $UPGRADE_AT Tehran time, or at once with: sudo nikou upgrade-scheduled"; fi
  fi
}

# What the nightly timer runs (also by hand): the newest waiting version. Nothing waiting = nothing happens.
cmd_upgrade_scheduled() {
  need_root upgrade-scheduled; load_conf
  local inc=$ROOT/incoming
  if [ "$MODE" = docker ]; then
    local m=$inc/pending-tag tag
    [ -f "$m" ] || { say "nothing is waiting"; return 0; }
    tag=$(head -1 "$m"); valid_tag "$tag" || { rm -f "$m"; die "the file $m held no valid tag; it was removed"; }
    cmd_upgrade "$tag"
    rm -f "$m"
    notify "upgraded" "The site now runs the Docker tag $tag."
  else
    local t v best="" bestv="" live; live=$(current_version)
    for t in $(ls -1 "$inc"/nikoufood-*-linux-"$(machine_arch)".tar.gz 2>/dev/null | sort -V || true); do
      [ -f "$t.sha256" ] || continue   # a tarball without its sum file is still being copied
      best=$t; bestv=$(parse_tarball_name "$t" | cut -d' ' -f1)
    done
    [ -n "$best" ] || { say "nothing is waiting"; return 0; }
    if [ -n "$live" ] && [ "$(printf '%s\n%s\n' "$live" "$bestv" | sort -V | tail -1)" = "$live" ]; then say "the waiting version $bestv is not newer than $live"; return 0; fi
    cmd_upgrade "$best"
    notify "upgraded" "The site now runs version $bestv (before: ${live:-none})."
    # keep the newest two tarballs for a manual re-run; older ones go
    for t in $(ls -1 "$inc"/nikoufood-*-linux-*.tar.gz 2>/dev/null | sort -V | head -n -2 || true); do rm -f "$t" "$t.sha256"; done
  fi
}

# ---------------------------------------------------------------------------------------------------------
# nikou github-deploy: GitHub sends each new release to this server (the "deploy" job in release.yml).
# Everything on the server is done here; only the GitHub secrets are pasted by the person, one at a time,
# and the secret key is shown on the terminal only and shredded at the end. The user is called nikoudeploy,
# not "deploy", so it never clashes with another app's deploy user and key on the same server.
DEPLOY_USER_NAME=nikoudeploy
deploy_known_hosts() { awk -v ip="$1" '{print ip, $1, $2; exit}' "${2:-/etc/ssh/ssh_host_ed25519_key.pub}"; }
deploy_wait() { read -r -p "  Press Enter when it is done > " _ </dev/tty || die "cancelled"; }
cmd_github_deploy() {
  need_root github-deploy; load_conf
  interactive || die "github-deploy guides you step by step: run it in a terminal (sudo nikou github-deploy)"
  local repo=${GITHUB_REPO:-pouryare/nikoufood} ip=${DEPLOY_HOST:-} dir du=$DEPLOY_USER_NAME
  [ -n "$ip" ] || ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}')
  [ -n "$ip" ] || die "could not find this server's address; run: sudo DEPLOY_HOST=<its public address> nikou github-deploy"
  [ -r /etc/ssh/ssh_host_ed25519_key.pub ] || die "this server has no ed25519 SSH host key (/etc/ssh/ssh_host_ed25519_key.pub)"
  command -v ssh-keygen >/dev/null || apt-get install -y -q openssh-client >/dev/null
  say "The key-only user GitHub copies releases as ($du)"
  id "$du" >/dev/null 2>&1 || { useradd -m -s /bin/bash "$du"; passwd -l "$du" >/dev/null; }
  install -d -m 755 "$ROOT"; install -d -o root -g "$du" -m 2775 "$ROOT/incoming"
  install -d -m 700 -o "$du" -g "$du" "/home/$du/.ssh"
  dir=$(mktemp -d); chmod 700 "$dir"
  trap 'shred -u "$dir"/key "$dir"/key.pub 2>/dev/null; rm -rf "$dir"; trap - RETURN' RETURN
  ssh-keygen -q -t ed25519 -N "" -C nikou-github-deploy -f "$dir/key"
  # One GitHub key at a time: an older one made here is replaced.
  touch "/home/$du/.ssh/authorized_keys"
  grep -v ' nikou-github-deploy$' "/home/$du/.ssh/authorized_keys" >"$dir/keep" || true
  cat "$dir/keep" "$dir/key.pub" >"/home/$du/.ssh/authorized_keys"
  chown "$du:$du" "/home/$du/.ssh/authorized_keys"; chmod 600 "/home/$du/.ssh/authorized_keys"
  {
    printf '\nA new key was made and given to the user %s. Now four short steps on GitHub.\n' "$du"
    printf '\nStep 1 of 4. Open https://github.com/%s/settings/environments\n  Open the environment called production (press "New environment" if there is none).\n' "$repo"
    deploy_wait
    printf '\nStep 2 of 4. Under "Environment secrets" press "Add environment secret".\n  Name:  DEPLOY_SSH_KEY\n  Value: everything between the lines below, including the BEGIN and END lines (select with the mouse, copy):\n\n'
    cat "$dir/key"
    printf '\n'
    deploy_wait
    printf '\nStep 3 of 4. Add more environment secrets:\n  Name: DEPLOY_USER   Value: %s\n  Name: DEPLOY_HOST   Value: %s\n' "$du" "$ip"
    if [ "$MODE" = docker ]; then printf '  Name: DEPLOY_MODE   Value: docker   (this server runs the Docker images; GitHub then only tells it to pull the new ones)\n'; fi
    deploy_wait
    printf '\nStep 4 of 4. Add the last one:\n  Name:  DEPLOY_KNOWN_HOSTS\n  Value: %s\n' "$(deploy_known_hosts "$ip")"
    deploy_wait
    printf '\nThe secret key is deleted from this server now. From the next release (a v... tag) GitHub sends it here by itself;\nit is applied at %s Tehran time, or at once with: sudo nikou upgrade-scheduled\n' "$UPGRADE_AT"
  } >/dev/tty
  install -d -m 755 "$CONF_DIR"; : > "$CONF_DIR/github-deploy.done"
}

# ---------------------------------------------------------------------------------------------------------
# nikou restore-test: put the newest backup into a scratch database, check it, throw it away. The live database is never touched.
RESTORE_DB=nikou_restore_test
swap_db() { database_url | sed -E "s#/$DB_NAME(\\?.*)?\$#/$1\\1#"; }
scratch_sql() {   # scratch_sql <database> [psql args] < sql
  local db=$1; shift
  if [ "$DB_MODE" = builtin ]; then compose exec -T db psql -U "$DB_USER" -d "$db" -X -q "$@"; else "$(pg_tool psql)" "$(swap_db "$db")" -X -q "$@"; fi
}
restore_db_drop() {
  case "$DB_MODE" in
    local | apt) runuser -u postgres -- psql -X -q -c "DROP DATABASE IF EXISTS $RESTORE_DB" >/dev/null 2>&1 || true ;;
    *) echo "DROP DATABASE IF EXISTS $RESTORE_DB;" | scratch_sql postgres >/dev/null 2>&1 || true ;;
  esac
}
restore_db_create() {
  restore_db_drop
  case "$DB_MODE" in
    local | apt) runuser -u postgres -- createdb -O "$DB_USER" "$RESTORE_DB" ;;
    *) echo "CREATE DATABASE $RESTORE_DB;" | scratch_sql postgres -v ON_ERROR_STOP=1 >/dev/null ;;
  esac
}
count_tables() { echo "select count(*) from information_schema.tables where table_schema = 'public'" | scratch_sql "$1" -tA; }
cmd_restore_test() {
  need_root restore-test; load_conf
  local dump media got live
  install -d "$DATA"
  dump=$(ls -1t "$BACKUPS"/nikou-db-*.sql.gz 2>/dev/null | head -1 || true)
  [ -n "$dump" ] || die "no backup found in $BACKUPS yet (sudo nikou backup)"
  gzip -t "$dump" || die "restore test FAILED: the newest database backup is damaged ($dump)"
  media=$(ls -1t "$BACKUPS"/nikou-media-*.tar.gz 2>/dev/null | head -1 || true)
  if [ -n "$media" ]; then tar -tzf "$media" >/dev/null 2>&1 || die "restore test FAILED: the newest files backup is damaged ($media)"; fi
  if ! restore_db_create 2>/dev/null; then
    warn "could not make a scratch database (the database user needs the CREATEDB right), so only the backup files were checked (they are readable)"
    return 0
  fi
  if ! gunzip -c "$dump" | scratch_sql "$RESTORE_DB" -v ON_ERROR_STOP=1 >/dev/null 2>"$DATA/restore-test.err"; then
    local why; why=$(tail -n 5 "$DATA/restore-test.err" 2>/dev/null || true)
    restore_db_drop; die "restore test FAILED: $(basename "$dump") does not restore. $why"
  fi
  got=$(count_tables "$RESTORE_DB" || echo 0); live=$(count_tables "$DB_NAME" || echo -1)
  restore_db_drop; rm -f "$DATA/restore-test.err"
  [[ $got =~ ^[0-9]+$ ]] && [ "$got" -ge 1 ] && [ "$got" = "$live" ] || die "restore test FAILED: the restored copy has $got tables, the live database $live"
  say "restore test passed: $(basename "$dump") restores into $got tables, like the live database${media:+; $(basename "$media") is readable}"
}

cmd_rollback() {
  need_root rollback; load_conf
  if [ "$MODE" = docker ]; then
    docker image inspect "$(image_ref nikoufood nikou-rollback)" >/dev/null 2>&1 || die "no previous version is kept on this server"
    local cur=$IMAGE_TAG
    IMAGE_TAG=nikou-rollback; render_compose > "$ROOT/docker-compose.yml"; compose up -d --remove-orphans
    wait_healthy 120 || die "the previous version does not answer either (nikou logs)"
    PREVIOUS_TAG=$cur; write_conf
    say "running the previous version again. Run 'nikou upgrade <tag>' to move to a version by name."
  else
    local prev; prev=$(previous_release); [ -n "$prev" ] || die "no previous release is kept on this server"
    switch_to "$prev"; systemctl restart "$SERVICE"
    wait_healthy 120 || die "the previous release does not answer either (nikou logs)"
    say "back on release $prev (database changes are not undone)"
  fi
}

cmd_restore() {
  need_root restore; load_conf
  local dump=${1:-} media=${2:-} word
  [ -f "$dump" ] || die "usage: nikou restore <nikou-db-….sql.gz> [nikou-media-….tar.gz]"
  printf 'This REPLACES the whole database%s with the backup. A safety backup is made first.\nType RESTORE to go on: ' "${media:+ and the uploaded files}"
  read -r word </dev/tty || die "cancelled"; [ "$word" = RESTORE ] || die "stopped, nothing was changed"
  BACKUP_ENABLED=1 cmd_backup --quiet
  if [ "$MODE" = docker ]; then compose stop app; else systemctl stop "$SERVICE"; fi
  printf 'DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public;\n' | db_sql
  gunzip -c "$dump" | db_sql
  if [ -n "$media" ]; then [ -f "$media" ] || die "no such file: $media"; rm -rf "${DATA:?}/media"; tar -xzf "$media" -C "$DATA"; if [ "$MODE" = docker ]; then chown -R 1001:1001 "$DATA/media"; else chown -R "$APP_USER:$APP_USER" "$DATA/media"; fi; fi
  start_app
  wait_healthy 120 && say "restored and running" || die "restored, but the site does not answer (nikou logs)"
}

cmd_maintenance() {
  need_root maintenance
  case "${1:-}" in
    on) install -d "$CONF_DIR"; : > "$CONF_DIR/maintenance.on"; say "maintenance page is ON for everyone" ;;
    off) rm -f "$CONF_DIR/maintenance.on"; say "maintenance page is OFF" ;;
    *) die "usage: nikou maintenance on|off" ;;
  esac
}

cmd_secrets() {
  need_root secrets
  local sub=${1:-list} key=${2:-} val=""
  case "$sub" in
    list) [ -f "$ENV_FILE" ] || die "no secrets file yet"; sed -E 's/^([A-Za-z_]+)=(.{0,3}).*/\1=\2***/' "$ENV_FILE" ;;
    set)
      [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "usage: nikou secrets set KEY (upper-case name)"
      read -r -s -p "Value for $key (nothing is shown): " val </dev/tty; printf '\n'
      safe_secret "$val" || die "the value must not contain quotes, \$ or backslash, and must not be empty"
      env_set "$key" "$val"; load_conf; if app_running; then start_app; fi; say "$key saved and the site restarted" ;;
    unset) [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "usage: nikou secrets unset KEY"; env_unset "$key"; load_conf; if app_running; then start_app; fi; say "$key removed" ;;
    *) die "usage: nikou secrets list | set KEY | unset KEY" ;;
  esac
}

cmd_reset_login() {
  need_root reset-login; load_conf
  local email=${1:-}; valid_email "$email" || die "usage: nikou reset-login <email>"
  local pw; pw=$(rand_hex 8)
  ADMIN_EMAIL=$email ADMIN_PASSWORD=$pw ADMIN_RESET=1 run_tools admin
  printf '\nNew password for %s (shown once): %s\n' "$email" "$pw"
}

cmd_first_login() {
  need_root first-login
  [ -f "$CONF_DIR/first-login" ] || die "no first-login note on this server"
  if [ "${1:-}" = --forget ]; then shred -u "$CONF_DIR/first-login" 2>/dev/null || rm -f "$CONF_DIR/first-login"; say "removed"; else cat "$CONF_DIR/first-login"; fi
}

redact() { sed -E 's/((PASS|PASSWORD|SECRET|TOKEN|KEY|SALT)[A-Z_]*=)[^[:space:]]*/\1***/gI; s#(postgres(ql)?://[^:/@]+:)[^@]+@#\1***@#g'; }
cmd_support_file() {
  need_root support-file; load_conf
  local out=${1:-/root/nikou-support-$(hostname)-$(date +%Y%m%d-%H%M).tar.gz} d; d=$(mktemp -d)
  { date -Is; uname -a; . /etc/os-release 2>/dev/null && echo "$PRETTY_NAME"; echo; redact < "$CONF"; } > "$d/info.txt"
  cmd_doctor > "$d/doctor.txt" 2>&1 || true
  app_logs 300 2>&1 | redact > "$d/app.log" || true
  tar -czf "$out" -C "$d" . && rm -rf "$d"
  say "no passwords inside; send this file for help: $out"
}

menu() {
  command -v whiptail >/dev/null || die "whiptail is not installed; run a command instead (nikou help)"
  local choice arg
  choice=$(whiptail --title "Nikoo Etemad" --menu "What do you want to do?" 23 76 14 \
    status "Show the state of the site" doctor "Check everything" logs "Follow the site's log" \
    update "Fetch the newest version; upgrade now or tonight" github-deploy "Let GitHub send new versions here (guided)" \
    upgrade "Upgrade to a named version or file" restore-test "Test the newest backup in a scratch database" rollback "Go back to the previous version" backup "Make a backup now" \
    maintenance-on "Show the maintenance page" maintenance-off "Hide the maintenance page" \
    first-login "Show the first login again" support-file "Make a file to send for help" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    upgrade) arg=$(whiptail --inputbox "Docker tag (latest, v1.0.0…) or path of the release tarball. Empty = same tag / newest tarball:" 10 70 "" 3>&1 1>&2 2>&3) || exit 0; exec "$0" upgrade $arg ;;
    maintenance-on) exec "$0" maintenance on ;;
    maintenance-off) exec "$0" maintenance off ;;
    *) exec "$0" "$choice" ;;
  esac
}

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd=${1:-}
  [ $# -eq 0 ] || shift
  case "$cmd" in
    "") if [ -t 0 ] && [ -w /dev/tty ]; then need_root; menu; else usage; fi ;;
    install) cmd_install "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    update) cmd_update "$@" ;;
    upgrade-scheduled) alerting "the scheduled upgrade" cmd_upgrade_scheduled "$@" ;;
    github-deploy) cmd_github_deploy "$@" ;;
    restore-test) alerting "the backup restore test" cmd_restore_test "$@" ;;
    health-check) cmd_health_check "$@" ;;
    rollback) cmd_rollback "$@" ;;
    status) cmd_status "$@" ;;
    doctor) cmd_doctor "$@" ;;
    logs) cmd_logs "$@" ;;
    backup) if [ "${1:-}" = --quiet ]; then alerting "the nightly backup" cmd_backup "$@"; else cmd_backup "$@"; fi ;;
    restore) cmd_restore "$@" ;;
    maintenance) cmd_maintenance "$@" ;;
    secrets) cmd_secrets "$@" ;;
    reset-login) cmd_reset_login "$@" ;;
    first-login) cmd_first_login "$@" ;;
    cdn-ips) cmd_cdn_ips "$@" ;;
    support-file) cmd_support_file "$@" ;;
    render) cmd_render "$@" ;;
    help | -h | --help) usage ;;
    *) warn "unknown command: $cmd"; usage >&2; exit 2 ;;
  esac
}

# Sourced by the tests: only run when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
