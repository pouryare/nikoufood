      FONTS_DIR: /data/media/fonts
YML
    if [ "$svc" = app ] && [ "$hostnet" = 1 ]; then printf '      PORT: "%s"\n      HOSTNAME: 127.0.0.1\n' "$APP_PORT"; fi
    printf '    volumes:\n      - %s/media:/data/media\n' "$DATA"
