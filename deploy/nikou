#!/usr/bin/env bash
# nikou: the one command for a Nikoo Etemad website server. Install, upgrade, roll back, check, back up,
# restore, read logs. Run it with no arguments on a terminal for a menu.
#
#   sudo bash install.sh                       # fresh server: the same questions as "nikou install"
#   sudo nikou install [tarball]               # asks the questions, then installs (re-run it to apply changed answers)
#   sudo DOMAIN=example.ir ADMIN_EMAIL=me@example.ir nikou install --yes     # no questions; answers from the environment
#   sudo nikou status | doctor | logs | first-login [--forget] | support-file
#   sudo nikou upgrade [docker tag | release tarball]     # Docker: pull + migrate + restart; native: unpack + migrate + switch
#   sudo nikou update [--now|--tonight]        # fetch the newest version, then ask: upgrade now, or tonight at UPGRADE_AT
#   sudo nikou upgrade-scheduled               # what the nightly timer runs: applies a waiting version
#   sudo nikou github-deploy                   # let GitHub send each new version here by itself (guided; 4 secrets to paste)
#   sudo nikou rollback                        # back to the version that ran before the last upgrade
#   sudo nikou backup | restore <dump.sql.gz> [media.tar.gz]
#   sudo nikou restore-test                    # restore the newest backup into a scratch database and check it (weekly, too)
#   sudo nikou maintenance on|off              # a short "we are updating" page for everyone
#   sudo nikou secrets list | set KEY | unset KEY
#   sudo nikou reset-login <email>             # a new random password for an admin account
#   sudo nikou cdn-ips [--open|--only]         # refresh the firewall from ArvanCloud's address list | open web ports | Arvan only
#   sudo nikou install --dry-run               # ask the questions and list what would be done; nothing is changed
#   sudo nikou                                 # whiptail menu
#
# Two ways to run the site, chosen in the install questions:
#   docker   the site and (optionally) PostgreSQL run as Docker containers; the images come from Docker Hub.
#   native   the site runs as a systemd service with its own Node, from a release tarball (scripts/release/pack.sh).
# PostgreSQL is one of: a container (docker), the PostgreSQL already on this server (a separate database and
# user are created; nothing of another app's is touched), one installed by this script (native), or any server you
# give the address and login of.
#
# Answers (no passwords) live in /etc/nikou/nikou.conf, passwords in /etc/nikou/env (mode 600). Every other
# file (compose file, Caddy site, systemd unit) is written from them, so "nikou install" again is safe.

set -euo pipefail

ROOT=${NIKOU_ROOT:-/opt/nikoufood}
CONF_DIR=${NIKOU_CONF_DIR:-/etc/nikou}
CADDY_DIR=${NIKOU_CADDY_DIR:-/etc/caddy}
DATA=${NIKOU_DATA:-/var/lib/nikou}
BACKUPS=${NIKOU_BACKUPS:-/var/backups/nikoufood}
UNIT_DIR=${NIKOU_UNIT_DIR:-/etc/systemd/system}
CONF=$CONF_DIR/nikou.conf
ENV_FILE=$CONF_DIR/env
SERVICE=nikoufood
APP_USER=nikou
LOCK=/run/lock/nikou.lock
CDN_IPS_URL=${CDN_IPS_URL:-https://www.arvancloud.ir/en/ips.txt}

say() { printf '== %s\n' "$*"; }
warn() { printf 'nikou: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root: sudo nikou $*"; }

# ---------------------------------------------------------------------------------------------------------
# Progress: "== [████░░░░░░] 4/12 name"
STEP_TOTAL=13
STEP_N=0
progress_bar() { local n=$1 t=$2 w=10 f i b=""; f=$((n * w / t)); for ((i = 0; i < w; i++)); do if ((i < f)); then b+="█"; else b+="░"; fi; done; printf '%s' "$b"; }
step() { STEP_N=$((STEP_N + 1)); printf '== [%s] %s/%s %s\n' "$(progress_bar "$STEP_N" "$STEP_TOTAL")" "$STEP_N" "$STEP_TOTAL" "$*"; }

# ---------------------------------------------------------------------------------------------------------
# Questions
interactive() { [ "${NIKOU_YES:-0}" != 1 ] && [ -t 0 ] && [ -w /dev/tty ]; }

ask() {   # ask VAR "question" [default]
  local var=$1 question=$2 default=${3:-} value reply
  value=${!var:-$default}
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    read -r -p "  [${value:-empty}] > " -e reply </dev/tty || die "cancelled"
    [ -z "$reply" ] || value=$reply
    [ "$reply" != "-" ] || value=""   # a single dash clears the answer
  fi
  printf -v "$var" '%s' "$value"
}

ask_yes() {   # ask_yes VAR "question" 1|0
  local var=$1 question=$2 default=${3:-1} reply
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    read -r -p "  [$([ "$default" = 1 ] && echo Y/n || echo y/N)] > " reply </dev/tty || die "cancelled"
    case "$reply" in [yY]*) default=1 ;; [nN]*) default=0 ;; esac
  fi
  printf -v "$var" '%s' "$default"
}

ask_secret() {   # ask_secret VAR "question"   (nothing is shown while typing; Enter keeps the current value)
  local var=$1 question=$2 reply
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    read -r -s -p "  > " reply </dev/tty || die "cancelled"
    printf '\n' >/dev/tty
    [ -z "$reply" ] || printf -v "$var" '%s' "$reply"
  fi
}

ask_choice() {   # ask_choice VAR "question" default_value "value|Label" ...
  local var=$1 question=$2 default=$3 current opt i=0 n reply label
  shift 3
  current=${!var:-$default}
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    for opt in "$@"; do i=$((i + 1)); label=${opt#*|}; printf '  %s) %s%s\n' "$i" "$label" "$([ "${opt%%|*}" = "$current" ] && echo '   (current)')" >/dev/tty; done
    n=$i
    read -r -p "  [$(i=0; for opt in "$@"; do i=$((i + 1)); [ "${opt%%|*}" = "$current" ] && echo $i; done)] > " reply </dev/tty || die "cancelled"
    if [[ $reply =~ ^[0-9]+$ ]] && [ "$reply" -ge 1 ] && [ "$reply" -le "$n" ]; then
      i=0; for opt in "$@"; do i=$((i + 1)); [ "$i" = "$reply" ] && current=${opt%%|*}; done
    fi
  fi
  printf -v "$var" '%s' "$current"
}

ask_valid() {   # ask_valid VAR "question" default validator_function "what is wrong"
  local var=$1 question=$2 default=$3 check=$4 bad=$5
  while :; do
    ask "$var" "$question" "$default"
    if "$check" "${!var}"; then return 0; fi
    interactive || die "$var: $bad"
    printf '  %s\n' "$bad" >/dev/tty
    default=${!var}; unset "$var"
  done
}

valid_domain() { [[ $1 =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]; }
valid_port() { [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_email() { [[ $1 =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; }
valid_ident() { [[ $1 =~ ^[a-z_][a-z0-9_]{0,40}$ ]]; }
valid_host() { [[ $1 =~ ^[A-Za-z0-9._:-]+$ ]]; }
valid_dockeruser() { [[ $1 =~ ^[a-z0-9][a-z0-9_.-]{3,30}$ ]]; }
valid_tag() { [[ $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; }
valid_optional_host() { [ -z "$1" ] || valid_host "$1"; }
# Passwords go into files that docker and systemd read as plain text, so a few characters are not allowed.
safe_secret() { [[ $1 != *[\"\'\$\\\`]* ]] && [[ $1 != *$'\n'* ]] && [ "${#1}" -ge 1 ]; }
valid_min8() { [ "${#1}" -ge 8 ] && safe_secret "$1"; }
reachable() { timeout 6 bash -c "exec 3<>/dev/tcp/$1/${2:-22}" 2>/dev/null; }

rand_hex() { openssl rand -hex "${1:-16}"; }
# Percent-encodes a value for use inside a postgres:// address.
urlenc() {
  local s=$1 i c out=""
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in [A-Za-z0-9._~-]) out+=$c ;; *) out+=$(printf '%%%02X' "'$c") ;; esac
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------------------------------------
# Answers
CONF_KEYS=(MODE DOMAIN APP_PORT DOCKERHUB_USER IMAGE_TAG DOCKER_MIRROR DB_MODE DB_HOST DB_PORT DB_NAME DB_USER DB_SSL
  ADMIN_EMAIL LOAD_SEED SMTP_HOST SMTP_PORT SMTP_SECURE SMTP_USER SMTP_FROM BEHIND_ARVAN CERT_MODE CDN_ONLY
  BACKUP_ENABLED KEEP_BACKUPS OFFSITE_HOST OFFSITE_USER OFFSITE_PATH PREVIOUS_TAG GITHUB_REPO UPGRADE_AT ALERT_EMAIL)

defaults() {
  MODE=${MODE:-docker}; DOMAIN=${DOMAIN:-}; APP_PORT=${APP_PORT:-3000}
  GITHUB_REPO=${GITHUB_REPO:-pouryare/nikoufood}; DOCKERHUB_USER=${DOCKERHUB_USER:-}; IMAGE_TAG=${IMAGE_TAG:-latest}; DOCKER_MIRROR=${DOCKER_MIRROR:-}
  DB_MODE=${DB_MODE:-builtin}; DB_HOST=${DB_HOST:-127.0.0.1}; DB_PORT=${DB_PORT:-5432}; DB_NAME=${DB_NAME:-nikou}
  DB_USER=${DB_USER:-nikou}; DB_SSL=${DB_SSL:-0}
  ADMIN_EMAIL=${ADMIN_EMAIL:-}; LOAD_SEED=${LOAD_SEED:-1}
  SMTP_HOST=${SMTP_HOST:-}; SMTP_PORT=${SMTP_PORT:-587}; SMTP_SECURE=${SMTP_SECURE:-false}; SMTP_USER=${SMTP_USER:-}; SMTP_FROM=${SMTP_FROM:-}
  BEHIND_ARVAN=${BEHIND_ARVAN:-0}; CERT_MODE=${CERT_MODE:-auto}; CDN_ONLY=${CDN_ONLY:-0}
  BACKUP_ENABLED=${BACKUP_ENABLED:-0}; KEEP_BACKUPS=${KEEP_BACKUPS:-14}
  OFFSITE_HOST=${OFFSITE_HOST:-}; OFFSITE_USER=${OFFSITE_USER:-}; OFFSITE_PATH=${OFFSITE_PATH:-}; PREVIOUS_TAG=${PREVIOUS_TAG:-}
  UPGRADE_AT=${UPGRADE_AT:-03:30}; ALERT_EMAIL=${ALERT_EMAIL:-}
}

load_conf() {
  # Values given in the environment win over the saved file (that is how "--yes" installs are driven).
  local k
  declare -A fromenv=()
  for k in "${CONF_KEYS[@]}"; do if [ -n "${!k+x}" ]; then fromenv[$k]=${!k}; fi; done
  if [ -f "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
  fi
  for k in "${!fromenv[@]}"; do printf -v "$k" '%s' "${fromenv[$k]}"; done
  defaults
}

write_conf() {
  local k
  install -d -m 755 "$CONF_DIR"
  {
    printf '# Written by "nikou install". Edit here, then run "nikou install" again to apply. Passwords are in %s.\n' "$ENV_FILE"
    for k in "${CONF_KEYS[@]}"; do printf '%s=%q\n' "$k" "${!k}"; done
  } > "$CONF.tmp"
  chmod 644 "$CONF.tmp"; mv "$CONF.tmp" "$CONF"
}

# Exports every KEY=value of the secrets file (the file is plain text, not shell syntax: values may hold spaces).
export_env() {
  local k v
  while IFS='=' read -r k v; do
    [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && export "$k=$v"
  done < "$ENV_FILE"
}

# KEY=value lines in the secrets file.
env_get() { [ -f "$ENV_FILE" ] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 || true; }
env_set() {   # env_set KEY value
  install -d -m 755 "$CONF_DIR"
  [ -f "$ENV_FILE" ] || ( umask 077; : > "$ENV_FILE" )
  if grep -q "^$1=" "$ENV_FILE" 2>/dev/null; then
    local tmp; tmp=$(mktemp); ( umask 077; grep -v "^$1=" "$ENV_FILE" > "$tmp" || true; printf '%s=%s\n' "$1" "$2" >> "$tmp" ); cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"
}
env_unset() { [ -f "$ENV_FILE" ] && sed -i "/^$1=/d" "$ENV_FILE" || true; }

database_url() {   # the address the SITE uses (from inside a container, the built-in one is called "db")
  local pass host=$DB_HOST q=""
  pass=$(env_get DB_PASSWORD)
  [ "$DB_MODE" = builtin ] && host=db
  [ "$DB_SSL" = 1 ] && q="?sslmode=require"
  printf 'postgres://%s:%s@%s:%s/%s%s' "$(urlenc "$DB_USER")" "$(urlenc "$pass")" "$host" "$DB_PORT" "$DB_NAME" "$q"
}

# ---------------------------------------------------------------------------------------------------------
# What else is on this server
other_app_conf() { [ -f /etc/routeflow/routeflow.conf ] && sed -n "s/^$1=//p" /etc/routeflow/routeflow.conf | tail -1 | tr -d "'\"" || true; }
other_app_present() { [ -f /etc/routeflow/routeflow.conf ] || systemctl is-active --quiet routeflow 2>/dev/null; }
# A port is "in use" when something answers on it (no extra tools needed, unlike ss).
port_free() { ! reachable 127.0.0.1 "$1"; }
local_pg_listening() { reachable 127.0.0.1 5432; }
local_pg_superuser() { command -v runuser >/dev/null && runuser -u postgres -- psql -X -tAc 'select 1' 2>/dev/null | grep -qx 1; }
# The newest PostgreSQL client tools installed (a newer pg_dump can read an older server, not the other way round).
pg_bindir() { ls -1d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1 || true; }
pg_tool() { local d; d=$(pg_bindir); if [ -n "$d" ] && [ -x "$d/$1" ]; then echo "$d/$1"; else echo "$1"; fi; }
db_on_this_host() { [[ $DB_HOST =~ ^(127\.0\.0\.1|localhost|::1)$ ]]; }

# ---------------------------------------------------------------------------------------------------------
# The install questions, in the order a person thinks about them (answer 1..9 can be changed before it starts)
q1() {
  ask_choice MODE "How should the site run?" "$MODE" \
    "docker|Docker (recommended): the ready-made images from Docker Hub, built by GitHub" \
    "native|Native: a systemd service from a release tarball (no Docker needed)"
}
q2() { ask_valid DOMAIN "The website's address, without https:// (for example nikoufood.ir)" "$DOMAIN" valid_domain "that is not a valid address (example: nikoufood.ir)"; }
q3() {
  local suggest=$APP_PORT
  if [ -z "${NIKOU_PORT_CHECKED:-}" ] && ! port_free "$suggest"; then
    while ! port_free "$suggest"; do suggest=$((suggest + 1)); done
    if interactive; then printf '\n  Port %s is already used on this server (another app on this server may use it), so %s is suggested.\n' "$APP_PORT" "$suggest" >/dev/tty; fi
  fi
  ask_valid APP_PORT "The local port the site listens on (only this server can reach it; Caddy forwards to it)" "$suggest" valid_port "a port is a number from 1 to 65535"
}
q4() {
  if [ "$MODE" = docker ]; then
    ask_valid DOCKERHUB_USER "Your Docker Hub user name (the images are <user>/nikoufood and <user>/nikoufood-tools)" "$DOCKERHUB_USER" valid_dockeruser "that does not look like a Docker Hub user name"
    ask_valid IMAGE_TAG "Which version to run (latest, or a tag such as v1.0.0 or sha-abc1234)" "$IMAGE_TAG" valid_tag "not a valid tag"
    ask DOCKER_MIRROR "A Docker registry mirror if Docker Hub is hard to reach (for example https://docker.arvancloud.ir). Type - for none" "$DOCKER_MIRROR"
    if [ -z "${DOCKERHUB_TOKEN:-}" ]; then ask_secret DOCKERHUB_TOKEN "Docker Hub access token (needed when the images are private; nothing is shown while you type; Enter = images are public)"; fi
  else
    if interactive; then printf '\n  Native install: the newest release file (nikoufood-<version>-linux-x64.tar.gz) is downloaded from GitHub (%s).\n  A file already next to install.sh or in %s/incoming/ is used instead, or give its path: nikou install /path/to/tarball\n' "$GITHUB_REPO" "$ROOT" >/dev/tty; fi
    if [ -z "$(gh_token)" ]; then ask_secret GITHUB_TOKEN "GitHub access token to download from the private repository (read access to Contents; nothing is shown while you type; Enter = the repository is public or the file is already here)"; fi
  fi
}
q5() {
  local have=1 pick
  # What is on this server, so the question can say it.
  if local_pg_listening && interactive; then
    printf '\n  A PostgreSQL is already running on this server (port 5432).%s\n  It will not be changed. You can give the site its own database and user inside it.\n' "$(other_app_present && echo ' Another app is installed here, and it uses a native PostgreSQL (not Docker).')" >/dev/tty
  fi
  case "$DB_MODE" in builtin | apt) have=0 ;; esac
  ask_yes DB_HAVE "Do you already have a PostgreSQL database for this site (or want to use the PostgreSQL on this server)?" "$have"
  if [ "$DB_HAVE" = 1 ]; then
    if local_pg_listening && local_pg_superuser; then
      ask_choice pick "How should the site connect?" "$([ "$DB_MODE" = external ] && echo external || echo local)" \
        "local|Use the PostgreSQL on this server: create a separate database and user for the site (recommended)" \
        "external|I will type the host, user and password myself"
      DB_MODE=$([ "$pick" = local ] && echo local || echo external)
    else
      DB_MODE=external
    fi
    if [ "$DB_MODE" = local ]; then
      DB_HOST=127.0.0.1; DB_PORT=5432; DB_SSL=0
      ask_valid DB_NAME "Name of the new database" "$DB_NAME" valid_ident "use lower-case letters, digits and _"
      ask_valid DB_USER "Name of the new database user" "$DB_USER" valid_ident "use lower-case letters, digits and _"
    else
      ask_valid DB_HOST "PostgreSQL host (name or IP address)" "$DB_HOST" valid_host "not a valid host"
      ask_valid DB_PORT "PostgreSQL port" "$DB_PORT" valid_port "a port is a number from 1 to 65535"
      ask_valid DB_NAME "Database name" "$DB_NAME" valid_ident "use lower-case letters, digits and _"
      ask_valid DB_USER "Database user" "$DB_USER" valid_ident "use lower-case letters, digits and _"
      ask_secret DB_PASSWORD_IN "Password of that user (nothing is shown while you type$([ -n "$(env_get DB_PASSWORD)" ] && echo '; Enter keeps the saved one'))"
      ask_yes DB_SSL "Require an encrypted (SSL) connection? Yes for a remote server, no for one on this machine" "$DB_SSL"
    fi
  else
    DB_MODE=$([ "$MODE" = docker ] && echo builtin || echo apt)
    DB_HOST=127.0.0.1; DB_PORT=5432; DB_SSL=0
    if interactive; then printf '\n  OK: PostgreSQL will be installed for you (%s). It listens only on this server.\n' "$([ "$MODE" = docker ] && echo 'as a Docker container next to the site' || echo 'from the Linux package archive')" >/dev/tty; fi
  fi
}
q6() {
  ask_valid ADMIN_EMAIL "Email of the first admin account for /admin" "$ADMIN_EMAIL" valid_email "not a valid email address"
  ask_secret ADMIN_PASSWORD "Its password (at least 8 characters; nothing is shown while you type; Enter = make a random one and show it at the end)"
  ask_yes LOAD_SEED "Load the starter content (all pages, texts, products and pictures you saw in the demo)? Choose no for an empty database" "$LOAD_SEED"
}
q7() {
  local want=0
  [ -n "$SMTP_HOST" ] && want=1
  ask_yes SMTP_WANT "Send form requests by email now? (You can do it later with: nikou secrets set SMTP_PASS)" "$want"
  if [ "$SMTP_WANT" = 1 ]; then
    ask_valid SMTP_HOST "Mail server (SMTP) host" "$SMTP_HOST" valid_host "not a valid host"
    ask_valid SMTP_PORT "SMTP port" "$SMTP_PORT" valid_port "a port is a number from 1 to 65535"
    ask SMTP_SECURE "Use SSL from the first byte (true for port 465, false for 587 or 25)" "$SMTP_SECURE"
    ask SMTP_USER "SMTP user name" "$SMTP_USER"
    local pw=""
    ask_secret pw "SMTP password (Enter keeps the saved one)"
    [ -z "$pw" ] || { safe_secret "$pw" || die "that password has a character not allowed here (quotes, \$, backslash); set it with: nikou secrets set SMTP_PASS"; env_set SMTP_PASS "$pw"; }
    ask_valid SMTP_FROM "Sender address of the emails" "${SMTP_FROM:-no-reply@${DOMAIN:-example.ir}}" valid_email "not a valid email address"
    ask_valid ALERT_EMAIL "Send failure alerts (a failed backup or upgrade, the site not answering) to this address" "${ALERT_EMAIL:-$ADMIN_EMAIL}" valid_email "not a valid email address"
  else
    SMTP_HOST=""
  fi
}
q8() {
  ask_yes BEHIND_ARVAN "Is the site behind the ArvanCloud CDN (the cloud proxy in front of your server)?" "$BEHIND_ARVAN"
  if [ "$BEHIND_ARVAN" = 1 ]; then
    ask_choice CERT_MODE "Certificate between Arvan and this server" "$CERT_MODE" \
      "auto|Let's Encrypt, automatic (works when plain HTTP reaches this server)" \
      "internal|Caddy's own certificate (set Arvan to 'don't verify')" \
      "origin|I will put origin.crt and origin.key in $CONF_DIR/tls/"
    ask_yes CDN_ONLY "Accept web traffic (ports 80 and 443) only from Arvan's addresses? Needs the ufw firewall to be on" "${CDN_ONLY:-1}"
  else
    CERT_MODE=auto; CDN_ONLY=0
  fi
}
q9() {
  ask_yes BACKUP_ENABLED "Make a nightly backup (database + uploaded files) on this server? Optional" "$BACKUP_ENABLED"
  if [ "$BACKUP_ENABLED" = 1 ]; then
    ask_valid KEEP_BACKUPS "How many days to keep them" "$KEEP_BACKUPS" valid_port "a number of days"
    ask_valid OFFSITE_HOST "Also copy them to another machine over SSH? Its address (type - for no)" "$OFFSITE_HOST" valid_optional_host "not a valid host"
    if [ -n "$OFFSITE_HOST" ]; then
      ask_valid OFFSITE_USER "User on that machine" "${OFFSITE_USER:-nikoubackup}" valid_ident "use lower-case letters, digits and _"
      ask OFFSITE_PATH "Folder on that machine" "${OFFSITE_PATH:-/srv/nikoufood-backups}"
    fi
  fi
}

answers_summary() {
  local db
  case "$DB_MODE" in
    builtin) db="a PostgreSQL container, installed for you" ;;
    apt) db="PostgreSQL installed on this server for you" ;;
    local) db="the PostgreSQL on this server ($DB_NAME, user $DB_USER, created for the site)" ;;
    *) db="$DB_USER@$DB_HOST:$DB_PORT/$DB_NAME" ;;
  esac
  printf '\n---- Summary ----\n'
  printf ' 1 Run as:       %s\n 2 Address:      https://%s\n 3 Local port:    %s\n' "$MODE" "$DOMAIN" "$APP_PORT"
  if [ "$MODE" = docker ]; then printf ' 4 Images:       %s/nikoufood:%s%s\n' "$DOCKERHUB_USER" "$IMAGE_TAG" "$([ -n "$DOCKER_MIRROR" ] && echo " via $DOCKER_MIRROR")"; else printf ' 4 Release:      from a tarball\n'; fi
  printf ' 5 PostgreSQL:   %s\n 6 First admin:  %s  (starter content: %s)\n' "$db" "$ADMIN_EMAIL" "$([ "$LOAD_SEED" = 1 ] && echo yes || echo no)"
  printf ' 7 Email:        %s\n 8 Arvan CDN:    %s\n' "${SMTP_HOST:-not now}" "$([ "$BEHIND_ARVAN" = 1 ] && echo "yes, certificate $CERT_MODE, Arvan only: $([ "$CDN_ONLY" = 1 ] && echo yes || echo no)" || echo no)"
  printf ' 9 Backups:      %s\n' "$([ "$BACKUP_ENABLED" = 1 ] && echo "nightly, $KEEP_BACKUPS days${OFFSITE_HOST:+, copied to $OFFSITE_HOST}" || echo off)"
}

install_questions() {
  local c
  interactive || return 0
  {
    printf '\n==== Nikoo Etemad website: install questions ====\n'
    printf 'Press Enter to keep the answer in [brackets]. You can change any answer before anything starts.\n'
    if other_app_present; then
      printf '\nAnother app is installed on this server (address %s, port %s). It is left exactly as it is:\nthis site gets its own Caddy file, its own port and its own database.\n' "$(other_app_conf DOMAIN)" "$(other_app_conf APP_PORT)"
    fi
  } >/dev/tty
  q1; q2; q3; q4; q5; q6; q7; q8; q9
  while :; do
    answers_summary >/dev/tty
    printf '\nPress Enter to start (about 10 minutes), a number 1 to 9 to change that answer, or Q to quit.\n' >/dev/tty
    read -r -p "  [start] > " c </dev/tty || die "cancelled"
    case "$c" in
      "") break ;;
      [qQ]*) die "stopped, nothing was changed" ;;
      [1-9]) "q$c" ;;
    esac
  done
}

check_answers() {   # the same rules for "--yes" runs, where nothing was asked
  valid_domain "$DOMAIN" || die "DOMAIN is missing or not a valid address (example: DOMAIN=nikoufood.ir)"
  valid_port "$APP_PORT" || die "APP_PORT is not a port"
  valid_email "$ADMIN_EMAIL" || die "ADMIN_EMAIL is missing or not an email address"
  case "$MODE" in docker) valid_dockeruser "$DOCKERHUB_USER" || die "DOCKERHUB_USER is missing (your Docker Hub user name)" ;; native) ;; *) die "MODE must be docker or native" ;; esac
  case "$DB_MODE" in builtin | apt | local | external) ;; *) die "DB_MODE must be builtin, apt, local or external" ;; esac
  [ "$MODE" = docker ] && [ "$DB_MODE" = apt ] && DB_MODE=builtin
  [ "$MODE" = native ] && [ "$DB_MODE" = builtin ] && DB_MODE=apt
  if [ "$DB_MODE" = external ]; then
    [ -n "${DB_PASSWORD_IN:-}" ] || [ -n "$(env_get DB_PASSWORD)" ] || die "DB_PASSWORD_IN (the database password) is missing"
  fi
  [ "$LOAD_SEED" = 1 ] || [ "$LOAD_SEED" = 0 ] || die "LOAD_SEED must be 1 or 0"
}

# ---------------------------------------------------------------------------------------------------------
# Files that are written from the answers
write_env() {
  install -d -m 755 "$CONF_DIR"
  local pw=${DB_PASSWORD_IN:-}
  if [ -n "$pw" ]; then
    safe_secret "$pw" || die "the database password has a character that is not allowed here (quotes, \$, backslash, new line)"
    env_set DB_PASSWORD "$pw"
  elif [ -z "$(env_get DB_PASSWORD)" ]; then
    env_set DB_PASSWORD "$(rand_hex 16)"
  fi
  [ -n "$(env_get PAYLOAD_SECRET)" ] || env_set PAYLOAD_SECRET "$(rand_hex 32)"
  [ -n "$(env_get IP_HASH_SALT)" ] || env_set IP_HASH_SALT "$(rand_hex 16)"
  env_set DATABASE_URL "$(database_url)"
  env_set SITE_URL "https://$DOMAIN"
  env_set SMTP_HOST "$SMTP_HOST"; env_set SMTP_PORT "$SMTP_PORT"; env_set SMTP_SECURE "$SMTP_SECURE"
  env_set SMTP_USER "$SMTP_USER"; env_set SMTP_FROM "$SMTP_FROM"
  [ -n "$(env_get SMTP_PASS)" ] || env_set SMTP_PASS ""
}

image_ref() { printf '%s/%s:%s' "$DOCKERHUB_USER" "$1" "${2:-$IMAGE_TAG}"; }

render_compose() {   # to stdout
  local hostnet=0
  db_on_this_host && [ "$DB_MODE" != builtin ] && hostnet=1
  printf '# Written by "nikou install" from %s. Do not edit; change the answers and run "nikou install" again.\nname: nikoufood\nservices:\n' "$CONF"
  if [ "$DB_MODE" = builtin ]; then
    cat <<YML
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: $DB_USER
      POSTGRES_DB: $DB_NAME
      POSTGRES_PASSWORD: $(env_get DB_PASSWORD)
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U $DB_USER -d $DB_NAME']
      interval: 5s
      retries: 20
YML
  fi
  for svc in app tools; do
    if [ "$svc" = app ]; then
      printf '  app:\n    image: %s\n    restart: unless-stopped\n' "$(image_ref nikoufood)"
    else
