# /etc/nginx/sites-available/nikoufood  — replace example.ir, then add a certificate (certbot --nginx).
server {
  listen 80;
  server_name example.ir www.example.ir;
  return 301 https://example.ir$request_uri;
}

server {
  listen 443 ssl http2;
  server_name example.ir;
  # ssl_certificate / ssl_certificate_key: added by certbot

  client_max_body_size 64m;      # video and picture uploads from the admin panel
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Built files never change under the same name.
  location /_next/static/ {
    proxy_pass http://127.0.0.1:3000;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
