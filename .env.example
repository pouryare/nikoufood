# --- Required ---
DATABASE_URL=postgres://user:password@localhost:5432/nikou
# Long random string (openssl rand -hex 32). Never reuse the dev value.
PAYLOAD_SECRET=
# Public address of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.ir

# --- Email notifications (leave SMTP_HOST empty to only log emails to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional ---
# Folder for uploaded images/videos (mount a volume here in production).
MEDIA_DIR=media
FONTS_DIR=media/fonts
# Salt used to anonymise visitor IPs stored with form submissions.
IP_HASH_SALT=

# --- Docker (docker-compose.yml) ---
DB_PASSWORD=
# Fallback addresses for form alerts, used only while the admin panel has none.
NOTIFY_EMAILS=

# --- Server with Docker Hub images (docker-compose.prod.yml) ---
DOCKERHUB_USER=
# Which image version to run: latest, or a tag like v1.0.0
IMAGE_TAG=latest
